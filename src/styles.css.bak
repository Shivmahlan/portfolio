:root {
  --parchment: #e2dedb;
  --bone: #cdc6be;
  --ink: #1d1d1b;
  --charcoal: #514c47;
  --ember: #9f2f0f;
  --line: rgb(29 29 27 / 48%);
  --display: Iowan Old Style, Baskerville, Georgia, serif;
  --text: Palatino, Book Antiqua, Georgia, serif;
  --radius: 3px;
  color: var(--ink);
  background: var(--parchment);
  font-family: var(--text);
  font-synthesis: none;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { min-width: 320px; margin: 0; background: var(--parchment); }
a { color: inherit; text-decoration: none; }
a:focus-visible { outline: 2px solid var(--ember); outline-offset: 4px; }
img { display: block; max-width: 100%; }
.shell { width: min(100% - 48px, 1440px); margin: 0 auto; }
.nav { min-height: 65px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--ink); font-size: 1rem; }
.nav-place { color: var(--charcoal); }
.wordmark { font-size: 1.2rem; letter-spacing: -.035em; }
.nav-menu { justify-self: end; display: grid; place-items: center; width: 32px; height: 32px; }
.nav-menu:hover, .hero-intro a:hover, .project a:hover, .contact-link:hover { color: var(--ember); }
.hero { display: grid; grid-template-columns: .75fr 1.45fr .85fr; gap: 26px; align-items: end; min-height: calc(100dvh - 65px); padding: 45px 0 62px; }
.hero-intro { max-width: 250px; padding-bottom: 12px; font-size: 1.1rem; line-height: 1.18; letter-spacing: -.028em; }
.hero-intro p { margin: 0 0 20px; }
.hero-intro a, .contact-link, .project a { display: inline-flex; gap: 6px; align-items: center; font-size: .93rem; text-decoration: underline; text-underline-offset: 4px; }
.hero-title-wrap { position: relative; align-self: center; }
h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { font-family: var(--display); font-weight: 400; letter-spacing: -.04em; text-wrap: balance; }
h1 { margin: 0; font-size: clamp(4.7rem, 8.2vw, 6rem); line-height: .82; }
h1 span { margin-left: -.04em; }
.hero-side-note { max-width: 130px; margin: 34px 0 0 auto; color: var(--charcoal); font-size: .85rem; line-height: 1.14; }
.hero-art { height: min(68vh, 590px); overflow: hidden; background: var(--bone); }
.hero-art img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; filter: sepia(.15) contrast(1.05); }
.masthead { overflow: hidden; background: var(--ink); color: var(--parchment); }
.masthead p { margin: 0; padding: 23px 0 15px; font-family: var(--display); font-size: clamp(4.25rem, 8.2vw, 6rem); line-height: .78; letter-spacing: -.04em; white-space: nowrap; }
.work { padding: 120px 0 125px; }
.work-heading { max-width: 660px; margin-bottom: 50px; }
.kicker { margin-bottom: 15px; color: var(--ember); font-size: .77rem; letter-spacing: .02em; text-transform: uppercase; }
h2 { margin-bottom: 18px; font-size: clamp(3rem, 6vw, 6rem); line-height: .86; }
.work-heading > p, .method-item p, .profile-copy > p:last-child { text-wrap: pretty; }
.work-heading > p:last-child { max-width: 500px; font-size: 1.15rem; line-height: 1.22; letter-spacing: -.025em; }
.project-grid { display: grid; grid-template-columns: 1.12fr .88fr .88fr; gap: 25px; align-items: start; }
.project-2 { margin-top: 70px; }
.project-3 { margin-top: 132px; }
.project { background: var(--bone); box-shadow: -4px 4px 6px rgb(29 29 27 / 17%); }
.project img { width: 100%; aspect-ratio: 1.15 / 1; object-fit: cover; filter: sepia(.11) contrast(1.03); }
.project-2 img { aspect-ratio: .84 / 1; object-position: 50% center; }
.project-3 img { aspect-ratio: .84 / 1; object-position: 70% center; }
.project-copy { padding: 20px 20px 22px; }
.project-title { display: flex; align-items: center; gap: 10px; margin-bottom: 5px; }
.project h3 { margin: 0; font-size: clamp(1.7rem, 2.6vw, 2.45rem); line-height: .94; letter-spacing: -.035em; }
.project-title span { padding: 4px 5px 3px; border-radius: var(--radius); background: var(--ember); color: var(--parchment); font-family: var(--text); font-size: .65rem; line-height: 1; text-transform: uppercase; }
.project-type { margin-bottom: 14px; color: var(--charcoal); font-size: .9rem; }
.project-copy > p:not(.project-type) { margin-bottom: 14px; font-size: .95rem; line-height: 1.2; }
.project small { display: block; margin-bottom: 22px; color: var(--charcoal); font-size: .75rem; line-height: 1.15; }
.method { display: grid; grid-template-columns: .88fr 1.12fr; gap: 10vw; padding: 115px 0; border-top: 1px solid var(--ink); }
.method-lead h2 { max-width: 520px; }
.method-list { display: grid; align-content: start; }
.method-item { display: grid; grid-template-columns: 44px 1fr; grid-template-areas: 'num title' 'num desc'; column-gap: 14px; padding: 21px 0; border-bottom: 1px solid var(--line); }
.method-item > span { grid-area: num; color: var(--ember); font-size: .78rem; }
.method-item h3 { grid-area: title; margin: 0 0 7px; font-size: 1.85rem; line-height: .9; }
.method-item p { grid-area: desc; max-width: 420px; margin: 0; color: var(--charcoal); font-size: .97rem; line-height: 1.25; }
.profile { display: grid; grid-template-columns: .77fr 1.23fr; gap: 10vw; align-items: center; padding: 105px 0; background: var(--bone); }
.profile::before { content: ''; }
.profile-seal { justify-self: center; display: grid; width: 165px; aspect-ratio: 1; place-items: center; border: 1px dashed var(--ember); border-radius: 50%; color: var(--ember); transform: rotate(-10deg); }
.profile-copy { padding-right: 52px; }
.profile-copy h2 { font-size: clamp(2.75rem, 5vw, 5.2rem); }
.profile-copy > p:last-child { max-width: 510px; margin: 0; color: var(--charcoal); font-size: 1.08rem; line-height: 1.25; }
.contact { padding: 125px 0 55px; border-top: 1px solid var(--ink); }
.contact h2 { max-width: 900px; margin-bottom: 32px; font-size: clamp(3.8rem, 7vw, 6rem); }
.contact-link { font-size: 1.15rem; }
.social-links { display: flex; gap: 9px; margin-top: 45px; }
.social-links a { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--ink); border-radius: var(--radius); }
.social-links a:hover { background: var(--ink); color: var(--parchment); }

@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
@media (max-width: 800px) {
  .shell { width: min(100% - 32px, 1440px); }
  .nav { grid-template-columns: 1fr auto; }
  .nav-place { display: none; }
  .wordmark { justify-self: start; }
  .hero { grid-template-columns: 1fr; min-height: auto; padding: 44px 0 55px; }
  .hero-intro { max-width: 300px; order: 2; }
  .hero-title-wrap { order: 1; }
  h1 { font-size: clamp(4.35rem, 19vw, 5.5rem); }
  .hero-side-note { margin: 25px 0 0; }
  .hero-art { height: 390px; order: 3; }
  .masthead p { font-size: clamp(3.7rem, 15vw, 5.3rem); }
  .work { padding: 80px 0; }
  .project-grid, .method, .profile { grid-template-columns: 1fr; gap: 26px; }
  .project-2, .project-3 { margin-top: 0; }
  .project img, .project-2 img, .project-3 img { aspect-ratio: 1.1 / 1; }
  .method, .profile { padding: 78px 0; }
  .profile-copy { padding: 0 24px 0 0; }
  .contact { padding: 82px 0 42px; }
}
